# Copy to backend/.env and fill in. Never commit the real file.

# Server. Render sets PORT itself. Locally 5001 (macOS AirPlay Receiver uses 5000).
PORT=5001
# "production" on Render: hides error details and refuses to start without JWT_SECRET
NODE_ENV=development
# Behind Render's proxy set to 1 so rate limits see the real client IP (production defaults to 1)
TRUST_PROXY=

# Database: local MongoDB, or a MongoDB Atlas M0 connection string
MONGODB_URI=mongodb://localhost:27017/hopr

# JWT signing secret: a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# The frontend's origin, allowed by CORS (your Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Optional: Mapbox token for server-side geocoding and road-following directions.
# Without it Hopr uses OpenStreetMap Photon and estimated road distances.
MAPBOX_TOKEN=

# Optional: fuel prices in INR (defaults are Ranchi retail prices)
FUEL_PRICE_PETROL=
FUEL_PRICE_DIESEL=
FUEL_PRICE_CNG=
FUEL_PRICE_ELECTRICITY=
