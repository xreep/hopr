# Copy to backend/.env and fill in. Never commit the real file.

# Server. Render sets PORT itself. Locally 5001 (macOS AirPlay Receiver uses 5000).
PORT=5001
# "production" on Render: hides error details and refuses to start without JWT_SECRET
NODE_ENV=development
# Behind Render's proxy set to 1 so rate limits see the real client IP (production defaults to 1)
TRUST_PROXY=

# Database: local MongoDB, or a MongoDB Atlas M0 connection string
MONGODB_URI=mongodb://localhost:27017/hopr

# JWT signing secret: a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# The frontend's origin, allowed by CORS (your Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Optional: true for a public demo (one-click demo data, demo morning, protected demo
# accounts). Leave unset for real use; the demo endpoints then do not exist.
DEMO_MODE=

# Optional: days to keep proof photos and signatures (default 90; 0 keeps them forever).
# The delivery record stays; only the image is deleted, so the free database does not fill up.
PROOF_RETENTION_DAYS=

# Optional: email notifications through Resend (free tier). Both must be set.
# EMAIL_FROM is a verified sender, e.g. Hopr <alerts@yourdomain.in>
RESEND_API_KEY=
EMAIL_FROM=

# Optional: report server errors to Sentry (free tier), without personal data.
SENTRY_DSN=

# Optional: Mapbox token for geocoding and road directions with live traffic
# (driving-traffic). Without it Hopr uses OpenStreetMap: Photon for search, OSRM for roads.
MAPBOX_TOKEN=

# Optional: fuel prices in INR (defaults are typical Indian retail prices)
FUEL_PRICE_PETROL=
FUEL_PRICE_DIESEL=
FUEL_PRICE_CNG=
FUEL_PRICE_ELECTRICITY=
