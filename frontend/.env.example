# Copy to frontend/.env. Never commit the real file.

# Local development: /api goes through the Vite proxy to http://localhost:5001
# (to change it, set VITE_PROXY_TARGET in the shell when starting the dev server).
# Production (Vercel): the full Render URL, e.g. https://hopr-api.onrender.com/api
VITE_API_URL=/api

# Optional: Mapbox public token (starts with pk.) for street maps in the browser.
# Without it Hopr draws a schematic map.
VITE_MAPBOX_TOKEN=
